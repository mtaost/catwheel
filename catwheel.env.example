# Copy this file to /etc/catwheel/catwheel.env. Do not commit the real file.
INFLUXDB_TOKEN=replace-with-your-influxdb-token
BUCKET=replace-with-your-bucket
ORG=replace-with-your-org
DATABASE_URL=http://influxdb-hostname-or-ip:8086
# Shared with the dashboard service. The parent directory must be writable by
# both the logger and catwheel-web users.
CATWHEEL_STATE_DB=/var/lib/catwheel/state.db
# Optional Telegram completion notifications. Configure both values or neither.
# Keep the bot token only in /etc/catwheel/catwheel.env; never commit it.
# TELEGRAM_BOT_TOKEN=replace-with-your-telegram-bot-token
# TELEGRAM_CHAT_ID=replace-with-your-telegram-chat-id
# Optional daily Telegram summary, sent at 12:05 AM for the prior local day.
# TELEGRAM_DAILY_SUMMARY_ENABLED=true
# Optional weekly summary, sent at 12:05 AM Monday for the prior local week.
# TELEGRAM_WEEKLY_SUMMARY_ENABLED=true
# INFLUXDB_READ_TOKEN=replace-with-your-read-only-influxdb-token
# DAILY_SUMMARY_TIME_ZONE=America/New_York
# Optional historical commands (/weekly, /hist, /heatmap) for the configured
# chat. They use the same read-only InfluxDB token.
# TELEGRAM_COMMANDS_ENABLED=true
# TELEGRAM_REPORT_TIME_ZONE=America/New_York
