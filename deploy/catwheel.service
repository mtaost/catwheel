[Unit]
Description=Catwheel GPIO logger
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=pi
Group=pi
SupplementaryGroups=gpio
WorkingDirectory=/home/pi/projects/catwheel
EnvironmentFile=/etc/catwheel/catwheel.env
ExecStart=/home/pi/projects/catwheel/venv/bin/python /home/pi/projects/catwheel/main.py
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
