[Unit]
Description=Catwheel web dashboard
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=catwheel-web
Group=catwheel
WorkingDirectory=/home/pi/projects/catwheel
EnvironmentFile=/etc/catwheel/web.env
ExecStart=/home/pi/projects/catwheel/venv/bin/uvicorn --factory web.app:create_app --host 0.0.0.0 --port 8080
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/var/lib/catwheel
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
