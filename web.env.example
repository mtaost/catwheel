# Copy to /etc/catwheel/web.env. Do not commit the real file.
# INFLUXDB_READ_TOKEN must be restricted to read access for this bucket only.
INFLUXDB_READ_TOKEN=replace-with-read-only-influxdb-token
BUCKET=replace-with-your-bucket
ORG=replace-with-your-org
DATABASE_URL=http://influxdb-hostname-or-ip:8086
CATWHEEL_STATE_DB=/var/lib/catwheel/state.db
DASHBOARD_TIME_ZONE=America/New_York
